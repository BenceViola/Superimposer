{
  "name": "superimposer",
  "version": "0.1.0",
  "description": "Browser tool for basic geometric morphometrics: Procrustes superimposition, PCA and plots for landmark-json and TPS data.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "build": "node scripts/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BenceViola/Superimposer.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
